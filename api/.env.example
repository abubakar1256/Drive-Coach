DATABASE_URL="postgresql://postgres:postgres@localhost:5432/driving_routes?schema=public"
PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
MAPBOX_DIRECTIONS_TOKEN=
# Hometown generation is disabled until the owner confirms the remaining provider allowance.
# These are hard shared reservation caps for this feature, NOT the account's free quota.
# Each generation reserves at most 8 requests; reservations are not refunded on failure.
HOMETOWN_DAILY_REQUEST_BUDGET=0
HOMETOWN_MONTHLY_REQUEST_BUDGET=0

# Optional production integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/account?checkout=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/account?checkout=cancelled
RESEND_API_KEY=
RESEND_FROM_EMAIL=
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Drive Coach

# Set MEDIA_PROVIDER=cloudinary to store uploads on a CDN instead of local disk
MEDIA_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=routepilot
